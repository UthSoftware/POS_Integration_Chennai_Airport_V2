
# Cloud API Configuration (Your POS Integration Endpoint)
CLOUD_API_URL=https://pos-integration-chennai-airport-v2.uthsoftware.com/api/vendor-data/ingest
CLOUD_API_KEY=your_api_key_here

# Vendor Database Configuration (Read from db_details.txt)
DB_DETAILS_FILE=./config/db_details.txt
QUERY_FILE=./config/query.txt

# Scheduler Configuration
FETCH_INTERVAL_MINUTES=15
ENABLE_SCHEDULER=true

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=2000

# Logging
LOG_LEVEL=info
NODE_ENV=production
