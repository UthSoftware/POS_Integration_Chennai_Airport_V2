# Cloud API Configuration
CLOUD_API_URL=https://pos-integration-chennai-airport-v2.uthsoftware.com/api/vendor-data/ingest
CLOUD_API_KEY=your_api_key_here
VENDOR_ID=VVC00047
VENDOR_NAME=eShopaidStore

# Data Source Mode: mock, live, auto
DATA_SOURCE_MODE=mock
MOCK_DATA_FILE=./data/sample_soap_response.json

# Local SOAP API Configuration
SOAP_URL=http://10.40.71.32:8080/eShopaidServices.asmx
SOAP_ACTION=http://eshopaid.in/GetResponseAsDataSet
SOAP_USERNAME=admin
SOAP_PASSWORD=pass
SOAP_TIMEOUT=60000

# Scheduler
ENABLE_SCHEDULER=false
FETCH_INTERVAL_MINUTES=15

# Server & Logging
PORT=4000
MAX_RETRIES=3
RETRY_DELAY_MS=2000
LOG_LEVEL=info
NODE_ENV=production
