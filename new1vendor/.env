# ===================================================================
# Cloud API Configuration (Vidveda POS Ingest Endpoint)
# ===================================================================
CLOUD_API_URL=https://pos-integration-chennai-airport-v2.uthsoftware.com/api/vendor-data/ingest
CLOUD_API_KEY=your_api_key_here

# Vendor Information
VENDOR_ID=VVC00047
VENDOR_NAME=eShopaidStore

# ===================================================================
# Data Source Mode Configuration
# Options:
#   mock : Uses data/sample_soap_response.json (ideal when off-site/offline)
#   live : Connects directly to SOAP_URL
#   auto : Tries live first; if unreachable, falls back to mock data
# ===================================================================
DATA_SOURCE_MODE=mock
MOCK_DATA_FILE=./data/sample_soap_response.json

# ===================================================================
# Local SOAP API Configuration (eShopaid ASMX)
# ===================================================================
SOAP_URL=http://10.40.71.32:8080/eShopaidServices.asmx
SOAP_ACTION=http://eshopaid.in/GetResponseAsDataSet
SOAP_USERNAME=admin
SOAP_PASSWORD=pass
SOAP_TIMEOUT=60000

# ===================================================================
# Scheduler Configuration
# ===================================================================
ENABLE_SCHEDULER=false
FETCH_INTERVAL_MINUTES=15

# ===================================================================
# Server & Logging Configuration
# ===================================================================
PORT=4000
MAX_RETRIES=3
RETRY_DELAY_MS=2000
LOG_LEVEL=info
NODE_ENV=development
